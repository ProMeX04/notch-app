#!/bin/zsh

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

open_url() {
    local url="$1"
    local app_path="${NOTCH_APP_PATH:-}"

    if [[ -z "$app_path" && -d "$ROOT_DIR/dist/Notch.app" ]]; then
        app_path="$ROOT_DIR/dist/Notch.app"
    fi

    if [[ -n "$app_path" && -d "$app_path" ]]; then
        open -a "$app_path" "$url"
    else
        open -g "$url"
    fi
}

usage() {
    cat <<'EOF'
Usage:
  notchctl panel <media|focus|talk|shelf>
  notchctl visibility <show|hide|toggle>
  notchctl pin <on|off|toggle>
  notchctl talk <show|connect|disconnect|toggle|mute|unmute|mic-toggle>
  notchctl screen <full|region|window|stop>
  notchctl caption <on|off|toggle>
  notchctl focus <show|pause|resume|toggle|reset|skip> [pomodoro]
  notchctl focus set [pomodoro] [focus-duration] [break-duration] [long-break-duration]
  notchctl focus start [pomodoro] [focus-duration] [break-duration] [long-break-duration]
  notchctl focus phase <focus|short-break|long-break>
  notchctl focus preset <sprint|classic|deep|custom-1|custom-2|custom-3>
  notchctl focus long-break <duration>
  notchctl focus cycle <count>
  notchctl focus auto-breaks <on|off|toggle>
  notchctl focus auto-pomo <on|off|toggle>
  notchctl media <play|pause|toggle|stop|next|previous|open>
  notchctl media volume <0-100>
  notchctl media skip-forward <seconds>
  notchctl media skip-backward <seconds>

Examples:
  notchctl panel talk
  notchctl talk connect
  notchctl talk mute
  notchctl screen region
  notchctl caption off
  notchctl focus start pomodoro 25m 5m 15m
  notchctl focus set pomodoro 50m 10m 20m
  notchctl focus preset deep
  notchctl focus phase long-break
  notchctl focus long-break 20m
  notchctl focus cycle 6
  notchctl focus auto-breaks on
  notchctl focus skip pomodoro
  notchctl media next
  notchctl media volume 35
  notchctl media skip-forward 30
EOF
}

url_encode() {
    local input="${1:-}"
    local output=""
    local char
    local hex
    local i
    local LC_ALL=C

    for (( i = 1; i <= ${#input}; i++ )); do
        char="${input[i]}"
        case "$char" in
            [a-zA-Z0-9.~_-])
                output+="$char"
                ;;
            ' ')
                output+="%20"
                ;;
            *)
                printf -v hex '%02X' "'$char"
                output+="%$hex"
                ;;
        esac
    done

    print -r -- "$output"
}

normalize_focus_tool() {
    local value="${1:-}"
    if [[ -z "$value" ]]; then
        echo ""
    elif [[ "$value" == "pomodoro" ]]; then
        echo "pomodoro"
    else
        usage
        exit 1
    fi
}

[[ $# -gt 0 ]] || {
    usage
    exit 1
}

domain="$1"
shift

case "$domain" in
    panel)
        [[ $# -eq 1 ]] || { usage; exit 1; }
        open_url "notch://panel/$1"
        ;;
    visibility)
        [[ $# -eq 1 ]] || { usage; exit 1; }
        open_url "notch://visibility/$1"
        ;;
    pin)
        [[ $# -eq 1 ]] || { usage; exit 1; }
        open_url "notch://pin/$1"
        ;;
    talk)
        [[ $# -eq 1 ]] || { usage; exit 1; }
        open_url "notch://talk/$1"
        ;;
    screen)
        [[ $# -eq 1 ]] || { usage; exit 1; }
        open_url "notch://screen/$1"
        ;;
    caption)
        [[ $# -eq 1 ]] || { usage; exit 1; }
        open_url "notch://caption/$1"
        ;;
    focus)
        [[ $# -ge 1 ]] || { usage; exit 1; }
        action="$1"
        shift
        url="notch://focus/$action"

        case "$action" in
            show|pause|resume|toggle|reset|skip)
                [[ $# -le 1 ]] || { usage; exit 1; }
                tool="$(normalize_focus_tool "${1:-}")"
                if [[ -n "$tool" ]]; then
                    url="${url}?tool=${tool}"
                fi
                ;;
            set|start)
                [[ $# -le 4 ]] || { usage; exit 1; }
                tool=""
                if [[ "${1:-}" == "pomodoro" ]]; then
                    tool="pomodoro"
                    shift
                fi
                duration="${1:-}"
                break_duration="${2:-}"
                long_break_duration="${3:-}"
                query=""
                if [[ -n "$tool" ]]; then
                    query="tool=${tool}"
                fi
                if [[ -n "$duration" ]]; then
                    [[ -n "$query" ]] && query="${query}&"
                    query="${query}duration=$(url_encode "$duration")"
                fi
                if [[ -n "$break_duration" ]]; then
                    [[ -n "$query" ]] && query="${query}&"
                    query="${query}break=$(url_encode "$break_duration")"
                fi
                if [[ -n "$long_break_duration" ]]; then
                    [[ -n "$query" ]] && query="${query}&"
                    query="${query}long=$(url_encode "$long_break_duration")"
                fi
                if [[ -n "$query" ]]; then
                    url="${url}?${query}"
                fi
                ;;
            phase)
                [[ $# -eq 1 ]] || { usage; exit 1; }
                url="${url}?phase=$(url_encode "$1")"
                ;;
            preset)
                [[ $# -eq 1 ]] || { usage; exit 1; }
                url="${url}?preset=$(url_encode "$1")"
                ;;
            long-break)
                [[ $# -eq 1 ]] || { usage; exit 1; }
                url="${url}?duration=$(url_encode "$1")"
                ;;
            cycle)
                [[ $# -eq 1 ]] || { usage; exit 1; }
                url="${url}?count=$(url_encode "$1")"
                ;;
            auto-breaks|auto-pomo)
                [[ $# -eq 1 ]] || { usage; exit 1; }
                url="${url}?state=$(url_encode "$1")"
                ;;
            *)
                usage
                exit 1
                ;;
        esac
        open_url "$url"
        ;;
    media)
        [[ $# -ge 1 ]] || { usage; exit 1; }
        action="$1"
        if [[ "$action" == "volume" ]]; then
            [[ $# -eq 2 ]] || { usage; exit 1; }
            open_url "notch://media/volume?level=$2"
        elif [[ "$action" == "skip-forward" || "$action" == "skip-backward" ]]; then
            [[ $# -eq 2 ]] || { usage; exit 1; }
            open_url "notch://media/$action?seconds=$2"
        else
            [[ $# -eq 1 ]] || { usage; exit 1; }
            open_url "notch://media/$action"
        fi
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        usage
        exit 1
        ;;
esac
