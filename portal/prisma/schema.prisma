// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String           @id @default(cuid())
  name         String?
  email        String?          @unique
  password     String?
  isPro        Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  sessions     AuthSession[]
  bridgeTokens AuthBridgeToken[]
  appBridgeTokens AuthAppBridgeToken[]
  oauthAuthorizationCodes OAuthAuthorizationCode[]
  payments     PaymentTransaction[]
}

model AuthSession {
  id              String    @id @default(cuid())
  tokenHash       String    @unique
  accessTokenHash String?   @unique
  deviceId        String?
  deviceName      String?
  platform        String?
  expiresAt       DateTime
  accessExpiresAt DateTime?
  createdAt       DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  trustedAt       DateTime?
  updatedAt       DateTime  @updatedAt
  revokedAt       DateTime?
  revokedReason   String?
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, deviceId])
  @@index([expiresAt])
  @@index([accessExpiresAt])
  @@index([lastSeenAt])
  @@index([trustedAt])
  @@index([revokedAt])
}

model AuthBridgeToken {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  consumedAt DateTime?
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthAppBridgeToken {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  deviceId   String?
  deviceName String?
  platform   String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  completedAt DateTime?
  consumedAt DateTime?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@index([completedAt])
}

model OAuthAuthorizationCode {
  id                  String   @id @default(cuid())
  codeHash            String   @unique
  clientId            String
  redirectUri         String
  codeChallenge       String
  codeChallengeMethod String
  expiresAt           DateTime
  createdAt           DateTime @default(now())
  consumedAt          DateTime?
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([clientId, redirectUri])
}

model PaymentTransaction {
  id             String   @id @default(cuid())
  provider       String
  status         String
  amount         Int
  currency       String
  orderId        String   @unique
  requestId      String   @unique
  providerRef    String?
  payUrl         String?
  orderInfo      String
  rawResponse    Json?
  rawNotification Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  paidAt         DateTime?
  guestEmail     String?
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([guestEmail])
  @@index([userId])
  @@index([status])
}
