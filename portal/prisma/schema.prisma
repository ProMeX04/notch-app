// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(cuid())
  name                    String?
  displayName             String?
  avatarUrl               String?
  email                   String?                  @unique
  password                String?
  isAdmin                 Boolean                  @default(false)
  isPro                   Boolean                  @default(false)
  leaderboardOptIn        Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  sessions                AuthSession[]
  bridgeTokens            AuthBridgeToken[]
  appBridgeTokens         AuthAppBridgeToken[]
  oauthAuthorizationCodes OAuthAuthorizationCode[]
  payments                PaymentTransaction[]
  events                  AppEvent[]
  focusDailyStats         FocusDailyStat[]
}

model FocusDailyStat {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime
  deviceId     String
  focusSeconds Int      @default(0)
  sessionCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, date, deviceId])
  @@index([userId, date])
  @@index([date])
}

model FeatureConfig {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "gemini_live", "advanced_pomodoro"
  name        String
  description String?
  isProOnly   Boolean  @default(true)
  isEnabled   Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model GeminiLiveModelConfig {
  id                         String   @id @default(cuid())
  modelId                    String   @unique
  displayName                String
  supportedGenerationMethods String[] @default(["bidiGenerateContent"])
  isEnabled                  Boolean  @default(true)
  sortOrder                  Int      @default(0)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@index([isEnabled])
  @@index([sortOrder])
}

model AuthSession {
  id              String    @id @default(cuid())
  tokenHash       String    @unique
  accessTokenHash String?   @unique
  deviceId        String?
  deviceName      String?
  platform        String?
  expiresAt       DateTime
  accessExpiresAt DateTime?
  createdAt       DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  trustedAt       DateTime?
  updatedAt       DateTime  @updatedAt
  revokedAt       DateTime?
  revokedReason   String?
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, deviceId])
  @@index([expiresAt])
  @@index([accessExpiresAt])
  @@index([lastSeenAt])
  @@index([trustedAt])
  @@index([revokedAt])
}

model AuthBridgeToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  consumedAt DateTime?
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthAppBridgeToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  deviceId    String?
  deviceName  String?
  platform    String?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  consumedAt  DateTime?
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@index([completedAt])
}

model OAuthAuthorizationCode {
  id                  String    @id @default(cuid())
  codeHash            String    @unique
  clientId            String
  redirectUri         String
  codeChallenge       String
  codeChallengeMethod String
  expiresAt           DateTime
  createdAt           DateTime  @default(now())
  consumedAt          DateTime?
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([clientId, redirectUri])
}

model GoogleDriveAuthHandoff {
  id            String    @id
  tokenHash     String    @unique
  codeChallenge String
  accessToken   String
  refreshToken  String?
  expiresIn     Int?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  consumedAt    DateTime?

  @@index([expiresAt])
  @@index([consumedAt])
}

model PaymentTransaction {
  id              String    @id @default(cuid())
  provider        String
  status          String
  amount          Int
  currency        String
  orderId         String    @unique
  requestId       String    @unique
  providerRef     String?
  payUrl          String?
  orderInfo       String
  rawResponse     Json?
  rawNotification Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  paidAt          DateTime?
  guestEmail      String?
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([guestEmail])
  @@index([userId])
  @@index([status])
}

model AppEvent {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  eventType     String
  outcome       String
  source        String
  actorUserId   String?
  actorUser     User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  sessionId     String?
  deviceId      String?
  requestPath   String?
  requestMethod String?
  statusCode    Int?
  ipHash        String?
  userAgent     String?
  metadata      Json?

  @@index([createdAt])
  @@index([eventType])
  @@index([outcome])
  @@index([actorUserId])
}
